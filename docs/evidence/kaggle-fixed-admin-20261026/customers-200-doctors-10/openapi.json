    "/api/appointments": {
      "post": {
        "tags": [
          "Public"
        ],
        "summary": "Khách hàng đặt lịch hẹn",
        "description": "Đặt lịch hẹn mới ở trạng thái PENDING mà không chỉ định bác sĩ. Hệ thống sinh mã tra cứu (booking code)",
