    "/api/doctors/{id}/available-slots": {
      "get": {
        "tags": [
          "Public"
        ],
        "summary": "Xem các khung giờ còn trống của bác sĩ",
        "description": "Tính toán các slot giờ 30 phút còn khả dụng của bác sĩ trong 1 ngày cụ thể",
        "operationId": "slots",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "serviceId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
