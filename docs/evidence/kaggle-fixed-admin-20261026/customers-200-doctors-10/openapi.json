{
  "openapi": "3.1.0",
  "info": {
    "title": "Dental Clinic Management API",
    "description": "Hệ thống backend đặt lịch khám nha khoa - Đồ án KTPM-BTL 2026",
    "contact": {
      "name": "Dental Clinic Team"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local / Docker"
    }
  ],
  "tags": [
    {
      "name": "Public",
      "description": "Các API công khai cho khách hàng (thông tin phòng khám, dịch vụ, bác sĩ, đặt hẹn, tra cứu)"
    },
    {
      "name": "Auth",
      "description": "Xác thực tài khoản và quản lý phiên đăng nhập (JWT)"
    },
    {
      "name": "Admin",
      "description": "Các API quản trị hệ thống phòng khám, phân công lịch và quản lý bác sĩ"
    },
    {
      "name": "Doctor",
      "description": "Các API dành cho Bác sĩ (xem lịch, đổi trạng thái, cập nhật hồ sơ cá nhân)"
    }
  ],
  "paths": {
    "/api/doctor/profile": {
      "get": {
        "tags": [
          "Doctor"
        ],
        "summary": "Xem hồ sơ bác sĩ",
        "description": "Lấy thông tin hồ sơ của bác sĩ đang đăng nhập",
        "operationId": "profile",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorView"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "put": {
        "tags": [
          "Doctor"
        ],
        "summary": "Cập nhật hồ sơ bác sĩ",
        "description": "Cập nhật thông tin cá nhân của bác sĩ đang đăng nhập",
        "operationId": "update",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DoctorUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorView"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
