          },
          "400": {
            "description": "Dữ liệu không hợp lệ (thời gian ở quá khứ, bước giờ sai, ngoài giờ làm việc, sai định dạng SĐT/Email)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentView"
                }
              }
            }
          },
          "404": {
            "description": "Dịch vụ không tồn tại",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentView"
                }
              }
            }
          }
        }
      }
    },
