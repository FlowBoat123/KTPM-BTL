              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorView"
                }
              }
            }
          },
          "400": {
            "description": "Dữ liệu cập nhật không hợp lệ",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorView"
                }
              }
            }
          },
          "401": {
            "description": "Chưa đăng nhập / Token không hợp lệ",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorView"
                }
              }
            }
          },
          "403": {
            "description": "Không có quyền Admin",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorView"
                }
              }
            }
          },
          "404": {
            "description": "Bác sĩ không tồn tại",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorView"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Admin"
        ],
        "summary": "Vô hiệu hóa tài khoản bác sĩ",
        "description": "Soft delete (active = false). Thu hồi quyền đăng nhập nhưng giữ nguyên lịch sử khám. Bị chặn nếu bác sĩ còn lịch hẹn đang mở",
        "operationId": "disable",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Vô hiệu hóa bác sĩ thành công"
          },
          "401": {
            "description": "Chưa đăng nhập / Token không hợp lệ"
          },
          "403": {
            "description": "Không có quyền Admin"
          },
          "404": {
            "description": "Bác sĩ không tồn tại"
          },
          "409": {
            "description": "Bác sĩ vẫn còn lịch hẹn đang mở (ASSIGNED hoặc CONFIRMED)"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
