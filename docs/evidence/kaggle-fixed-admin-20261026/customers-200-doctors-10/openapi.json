  "components": {
    "schemas": {
      "DoctorUpdate": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "specialization": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0,
            "pattern": "[+]?[0-9][0-9 ()-]{6,18}[0-9]"
          },
          "email": {
            "type": "string",
            "maxLength": 160,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "fullName",
          "specialization"
        ]
      },
      "DoctorView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "fullName": {
            "type": "string"
          },
          "specialization": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "Login": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 0
          }
        },
        "required": [
          "password",
          "username"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "DOCTOR"
            ]
          }
        }
      },
      "Booking": {
        "type": "object",
        "properties": {
          "patientName": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0,
            "pattern": "[+]?[0-9][0-9 ()-]{6,18}[0-9]"
          },
          "email": {
            "type": "string",
            "maxLength": 160,
            "minLength": 0
          },
          "serviceId": {
            "type": "integer",
            "format": "int64"
          },
          "preferredDate": {
            "type": "string",
            "format": "date"
          },
          "preferredTime": {
            "$ref": "#/components/schemas/LocalTime"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "patientName",
          "phone",
          "preferredDate",
          "preferredTime",
          "serviceId"
        ]
      },
      "LocalTime": {
        "type": "object",
        "properties": {
          "hour": {
            "type": "integer",
            "format": "int32"
          },
          "minute": {
            "type": "integer",
            "format": "int32"
          },
          "second": {
            "type": "integer",
            "format": "int32"
          },
          "nano": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AppointmentView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "code": {
            "type": "string"
          },
          "patientName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "serviceId": {
            "type": "integer",
            "format": "int64"
          },
          "serviceName": {
            "type": "string"
          },
          "preferredDate": {
            "type": "string",
            "format": "date"
          },
          "preferredTime": {
            "$ref": "#/components/schemas/LocalTime"
          },
          "note": {
            "type": "string"
          },
          "doctorId": {
            "type": "integer",
            "format": "int64"
          },
          "doctorName": {
            "type": "string"
          },
          "appointmentDate": {
            "type": "string",
            "format": "date"
          },
          "startTime": {
            "$ref": "#/components/schemas/LocalTime"
          },
          "endTime": {
            "$ref": "#/components/schemas/LocalTime"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ASSIGNED",
              "CONFIRMED",
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DoctorCreate": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "pattern": "[a-zA-Z0-9_.-]{3,80}"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8
          },
          "fullName": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "specialization": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0,
            "pattern": "[+]?[0-9][0-9 ()-]{6,18}[0-9]"
          },
          "email": {
            "type": "string",
            "maxLength": 160,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "fullName",
          "password",
          "specialization",
          "username"
        ]
      },
      "StatusChange": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "ASSIGNED",
              "CONFIRMED",
              "COMPLETED",
              "CANCELLED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Assignment": {
        "type": "object",
        "properties": {
          "doctorId": {
            "type": "integer",
            "format": "int64"
          },
          "appointmentDate": {
            "type": "string",
            "format": "date"
          },
          "startTime": {
            "$ref": "#/components/schemas/LocalTime"
          }
        },
        "required": [
          "appointmentDate",
          "doctorId",
          "startTime"
        ]
      },
      "ServiceView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "type": "number"
          }
        }
      },
      "AvailableSlots": {
        "type": "object",
        "properties": {
          "doctorId": {
            "type": "integer",
            "format": "int64"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocalTime"
            }
          }
        }
      },
      "ClinicView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "openingTime": {
            "$ref": "#/components/schemas/LocalTime"
          },
          "closingTime": {
            "$ref": "#/components/schemas/LocalTime"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "name": "BearerAuth",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
